# HuggingFace Token (Required)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notification Backend - chọn 1 trong 3 options dưới đây:

# Option 1: Google Chat
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/xxx/messages?key=xxx

# Option 2: Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Option 3: Email (Gmail example)
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx  # App Password, không phải password thường

# Optional: MLflow tracking
# MLFLOW_TRACKING_URI=https://dagshub.com/robotpro682004/my-first-repo.mlflow
# MLFLOW_TRACKING_USERNAME=robotpro682004
# MLFLOW_TRACKING_PASSWORD=xxx
